# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_DATABASE=web3_university

# Pinata IPFS配置
# https://app.pinata.cloud/onboarding
PINATA_JWT_TOKEN=your_pinata_jwt_token
PINATA_GATEWAY_DOMAIN=your_pinata_gateway_domain
PINATA_UPLOAD_URL=https://uploads.pinata.cloud/v3/files
PINATA_FILE_URL=https://api.pinata.cloud/v3/files

# 应用配置
PORT=3000
NODE_ENV=development
API_PREFIX=api

# 日志配置
LOG_LEVEL=info
