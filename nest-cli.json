{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "watchAssets": true,
    "assets": [
      {
        "include": "**/*.html",
        "watchAssets": true
      },
      { "include": "config/*.crt", "outDir": "dist" }
    ]
  }
}
